{
  "name": "english-audio-generator",
  "version": "0.1.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "node --import tsx --test src/*.test.ts",
    "generate:phrases": "tsx src/generate-phrases.ts",
    "prepare:script": "tsx src/prepare-script.ts",
    "generate:speech": "tsx src/generate-speech.ts",
    "build:lesson": "tsx src/build-lesson.ts",
    "lesson": "npm run generate:phrases && npm run generate:speech && npm run build:lesson",
    "lesson:script": "tsx src/run-script-lesson.ts",
    "generate:training-index": "tsx src/generate-training-index.ts",
    "build:training-audio": "tsx src/build-training-audio.ts",
    "build:training": "npm run build:training-audio && npm run web:build",
    "web:dev": "vite",
    "web:build": "npm run generate:training-index && vite build"
  },
